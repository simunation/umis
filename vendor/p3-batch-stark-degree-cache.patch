     /// There is one `Lookups<Val<SC>>` per STARK instance.
     /// They are stored in the same order as the STARK instance inputs provided to `new`.
     pub lookups: Vec<Lookups<Val<SC>>>,
+    /// umis local patch: memoized quotient chunk counts (see [`QuotientDegreeCache`]).
+    pub quotient_degrees: QuotientDegreeCache,
+}
+
+/// umis local patch: the log₂ quotient chunk count of each instance, inferred symbolically on
+/// the first prove or verify and reused afterwards (the inference evaluates the whole AIR
+/// symbolically and dominated small proofs). Keyed by the instance index and every input of
+/// the inference that is not fixed by the AIR list this `CommonData` was built for: the
+/// layout, the trace height and the ZK flag. Callers must pair a `CommonData` with the AIRs it
+/// was built from (as for its lookups and preprocessed commitment).
+///
+/// A wrong count could only make honest proofs fail (the quotient identity is checked at a
+/// random point against chunks whose degree FRI bounds, whatever their number), never accept a
+/// false one.
+#[derive(Default)]
+pub struct QuotientDegreeCache(
+    std::sync::Mutex<alloc::collections::BTreeMap<(usize, [usize; 4], usize, usize), usize>>,
+);
+
+impl QuotientDegreeCache {
+    /// The cached count for `key`, or `f()` (stored).
+    pub fn get_or_compute(
+        &self,
+        instance: usize,
+        layout: &p3_air::symbolic::AirLayout,
+        log_degree: usize,
+        is_zk: usize,
+        f: impl FnOnce() -> usize,
+    ) -> usize {
+        let key = (
+            instance,
+            [
+                layout.preprocessed_width,
+                layout.main_width,
+                layout.num_public_values,
+                layout.num_periodic_columns,
+            ],
+            log_degree,
+            is_zk,
+        );
+        if let Some(v) = self.0.lock().expect("quotient degree cache").get(&key) {
+            return *v;
+        }
+        let v = f();
+        self.0.lock().expect("quotient degree cache").insert(key, v);
+        v
+    }
 }
 
