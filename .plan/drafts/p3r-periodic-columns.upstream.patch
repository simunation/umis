+++ b/recursion/tests/periodic_columns.rs
@@ -0,0 +1,71 @@
+//! Batch AIRs with periodic columns: the transcript replay must build each AIR's symbolic
+//! layout with its periodic columns (it asserted otherwise: `AirLayout num_periodic_columns
+//! does not match AIR`).
+
+use std::borrow::Cow;
+
+use p3_air::{Air, AirBuilder, BaseAir, WindowAccess};
+use p3_batch_stark::{ProverData, StarkInstance, prove_batch, verify_batch};
+use p3_field::PrimeCharacteristicRing;
+use p3_lookup::logup::LogUpGadget;
+use p3_matrix::dense::RowMajorMatrix;
+use p3_recursion::replay_batch_stark_transcript;
+use p3_test_utils::baby_bear_params::*;
+
+const ROWS: usize = 8;
+
+/// One column `x` with `x = 1` on even rows, selected by a periodic column `[1, 0]`.
+#[derive(Clone, Copy)]
+struct EvenRowsAreOne;
+
+impl BaseAir<F> for EvenRowsAreOne {
+    fn width(&self) -> usize {
+        1
+    }
+    fn num_periodic_columns(&self) -> usize {
+        1
+    }
+    fn periodic_columns(&self) -> Cow<'_, [Vec<F>]> {
+        Cow::Owned(vec![vec![F::ONE, F::ZERO]])
+    }
+}
+
+impl<AB: AirBuilder<F = F>> Air<AB> for EvenRowsAreOne {
+    fn eval(&self, builder: &mut AB) {
+        // Indexing fails loudly if a builder was created without the periodic column.
+        let even: AB::Expr = builder.periodic_values()[0].into();
+        let x: AB::Expr = builder.main().current_slice()[0].into();
+        builder.assert_zero(even * (x - AB::Expr::ONE));
+    }
+}
+
+#[test]
+fn batch_transcript_replay_supports_periodic_columns() {
+    let config = make_test_config();
+    let air = EvenRowsAreOne;
+    let trace = RowMajorMatrix::new(
+        (0..ROWS)
+            .map(|r| if r % 2 == 0 { F::ONE } else { F::from_u32(7) })
+            .collect(),
+        1,
+    );
+    let public_values: Vec<F> = vec![];
+    let instances = vec![StarkInstance {
+        air: &air,
+        trace: &trace,
+        public_values: public_values.clone(),
+    }];
+    let prover_data = ProverData::from_instances(&config, &instances).unwrap();
+    let proof = prove_batch(&config, &instances, &prover_data).unwrap();
+    let publics = core::slice::from_ref(&public_values);
+    verify_batch(&config, &[air], &proof, publics, &prover_data.common).unwrap();
+    replay_batch_stark_transcript(
+        &[air],
+        &config,
+        &proof,
+        publics,
+        &prover_data.common,
+        &LogUpGadget::new(),
+    )
+    .expect("replay of a batch proof whose AIR has a periodic column");
+}
